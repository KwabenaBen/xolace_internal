# Copy to .env.local (git-ignored). `bunx convex dev` writes these for you on first run.
# Only EXPO_PUBLIC_* values reach the app bundle — never put secrets in them.

# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex URL the app connects to
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Server-side secrets (JWT_PRIVATE_KEY, JWKS) live on the Convex deployment, not here:
# set them with `bunx convex env set` (see CLAUDE.md → "First-time setup").
